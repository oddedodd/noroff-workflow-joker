{
  "name": "oddedodd-joker",
  "version": "0.2.1",
  "description": "Application that tells jokes",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node src/js/joker.test.js",
    "format": "prettier -w src/**/*.js",
    "lint": "eslint src/**/*.js",
    "lint-fix": "eslint src/**/*.js --cache --fix",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/oddedodd/noroff-workflow-joker.git"
  },
  "keywords": [
    "css",
    "js",
    "website"
  ],
  "author": "Odd Egil H. Selnes <post@odde.org>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oddedodd/noroff-workflow-joker/issues"
  },
  "homepage": "https://github.com/oddedodd/noroff-workflow-joker#readme",
  "devDependencies": {
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "give-me-a-joke": "^0.5.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
